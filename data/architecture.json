    {
      "id": "SECURITY_CONTROLLER",
      "trust_zone": "TZ-BODY",
      "technology_context": {
        "software_technologies": [
          {
            "type": "firmware_module",
            "component": "VCSEC (Vehicle Controller Security)",
            "detail": "VCSEC module confirmed as dedicated SoC embedded within VCLe ECU. Previously a standalone ECU; now integrated. VCSEC firmware is present on the infotainment filesystem for multiple board revisions (vcsec/7, vcsec/23, vcsec/24). Firmware files in unencrypted .bhx format. Version analyzed at Hexacon 2024: hw-id 134217729 (VCSEC_ConfigID_24), used in recent Model 3 'Highland' variant since October 2023.",
            "source": "https://www.synacktiv.com/sites/default/files/2024-10/hexacon_0_click_rce_on_tesla_model_3_through_tpms_sensors_light.pdf"
          },
          {
            "type": "operating_system",
            "component": "FreeRTOS",
            "detail": "FreeRTOS confirmed as VCSEC operating system via direct firmware reverse engineering",
            "source": "https://www.synacktiv.com/sites/default/files/2024-10/hexacon_0_click_rce_on_tesla_model_3_through_tpms_sensors_light.pdf"
          },
          {
            "type": "library",
            "component": "Mbed-TLS",
            "detail": "Mbed-TLS library confirmed in VCSEC firmware. Used in certificate handling code path \u2014 directly relevant to the CVE-2025-2082 integer overflow in certificate reassembly.",
            "source": "https://www.synacktiv.com/sites/default/files/2024-10/hexacon_0_click_rce_on_tesla_model_3_through_tpms_sensors_light.pdf"
          },
          {
            "type": "library",
            "component": "nanopb (Protocol Buffer)",
            "detail": "nanopb confirmed in VCSEC firmware for Protobuf message deserialization. Used on BLE and UWB interfaces. .proto shared between TPMS and Tesla App features.",
            "source": "https://www.synacktiv.com/sites/default/files/2024-10/hexacon_0_click_rce_on_tesla_model_3_through_tpms_sensors_light.pdf"
          }
        ],
        "hardware_technologies": [
          {
            "type": "chipset",
            "component": "ST SPC56 PowerPC SoC",
            "detail": "VCSEC runs on a dedicated PowerPC SoC: SPC56 family from STMicroelectronics, operating in VLE (Variable Length Encoding) mode. Confirmed via firmware reverse engineering on IDA Pro with PPC VLE decompiler.",
            "source": "https://www.synacktiv.com/sites/default/files/2024-10/hexacon_0_click_rce_on_tesla_model_3_through_tpms_sensors_light.pdf"
          }
        ],
        "communication_technologies": [
          {
            "type": "protocol",
            "component": "BLE (Bluetooth Low Energy)",
            "detail": "BLE confirmed on SECURITY_CONTROLLER/VCSEC. Multiple BLE endpoints (Center/Left/Right/Rear/Rear Left) connected via UART-to-CAN transceivers. BLE GATT service UUID 00000211-b2d1-43f0-9b88-960cebf8b91e. Messages serialized with Protocol Buffer (nanopb). Supports Tesla Mobile App, TPMS sensors.",
            "source": "https://www.synacktiv.com/sites/default/files/2024-10/hexacon_0_click_rce_on_tesla_model_3_through_tpms_sensors_light.pdf"
          },
          {
            "type": "protocol",
            "component": "UWB (Ultra-Wideband)",
            "detail": "UWB interface confirmed on SECURITY_CONTROLLER. Used for Tesla App proximity features. Protobuf message protocol shared with BLE stack.",
            "source": "https://www.zerodayinitiative.com/advisories/ZDI-25-265/"
          },
          {
            "type": "protocol",
            "component": "UDS (Unified Diagnostic Services)",
            "detail": "UDS present on VCSEC for maintenance and provisioning (CAN-connected)",
            "source": "https://www.synacktiv.com/sites/default/files/2024-10/hexacon_0_click_rce_on_tesla_model_3_through_tpms_sensors_light.pdf"
          }
        ],
        "update_technologies": [
          {
            "type": "firmware_update_path",
            "component": "Security Gateway \u2192 infotainment filesystem",
            "detail": "VCSEC firmware is updated by the Security Gateway, which fetches firmware images from the infotainment system filesystem. Firmware present in infotainment rootfs for multiple board revisions. This makes infotainment compromise a prerequisite for VCSEC firmware tampering.",
            "source": "https://www.synacktiv.com/sites/default/files/2024-10/hexacon_0_click_rce_on_tesla_model_3_through_tpms_sensors_light.pdf"
          }
        ]
      },
      "control_authority": "actuating",
      "security_function": "authentication"
    },
